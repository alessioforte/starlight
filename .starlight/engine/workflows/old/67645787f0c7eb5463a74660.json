    {
      "dependencies": ["67bc864a55abf2ae57a48177"],
      "params": {
        "consts": {
          "g": 9.81,
          "base_ms": 1746576000000
        },
        "vars": {
          "vmod": "vmod",
          "timestamp": "timestamp",
          "timeline": "timeline",
          "ax": "ax",
          "ay": "ay"
        },
        "expressions": {
          "hours": "floor(timestamp / 10000)",
          "minutes": "floor((timestamp % 10000) / 100)",
          "seconds": "timestamp % 100",
          "time_ms": "(hours * 3600 + minutes * 60 + seconds) * 1000",
          "offset_ms": "timeline * 1000",
          "unix": "base_ms + time_ms + offset_ms",
          "amod": "math::sqrt(math::pow(ax, 2) + math::pow(ay, 2))",
          "a": "math::atan(g / amod)",
          "v": "vmod / 3.6",
          "es": "math::tan((consts::PI / 2.0) - a)",
          "em": "math::sqrt(math::pow(ax / g, 2) + math::pow(ay / g, 2) + 1.0)",
          "ec": "(155.4 * math::pow(es, 5) - 30.4 * math::pow(es, 4) - 43.3 * math::pow(es, 3) + 46.3 * math::pow(es, 2) + 19.5 * es + 3.6) * em",
          "mp": "ec * v"
        },
        "mapping": {
          "amod": "amod",
          "mp": "mp",
          "unix": "timestamp"
        }
      },
      "handles": {
        "out": ["67bc864a55abf2ae57a48183"]
      },
      "id": "67645795978d119d1d632342",
      "type": "math_exp_eval"
    },

